{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet-digital-twin.local/contracts/machine_state.schema.json",
  "title": "PET Digital Twin Machine State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "machine_id",
    "machine_type",
    "state",
    "simulation_time",
    "progress",
    "queue",
    "temperature",
    "pressure",
    "produced",
    "rejected"
  ],
  "properties": {
    "machine_id": {
      "type": "string",
      "anyOf": [
        {"enum": ["D-101", "H-101", "CV-101", "BF-101", "OV-101", "QC-101", "PKG-101"]},
        {"pattern": "^IMM-[1-9][0-9]{2,}$"},
        {"pattern": "^SBM-[1-9][0-9]{2,}$"}
      ]
    },
    "machine_type": {
      "type": "string",
      "enum": ["dryer", "material_hopper", "injection_molding", "cooling_conveyor", "preform_buffer", "reheat_oven", "stretch_blow_molding", "quality_control", "packaging"]
    },
    "state": {
      "type": "string",
      "enum": ["IDLE", "WAITING", "RUNNING", "FAULT", "MAINTENANCE", "FINISHED"]
    },
    "simulation_time": {"type": "number", "minimum": 0, "description": "Simulation time in seconds."},
    "progress": {"type": "number", "minimum": 0, "maximum": 1, "description": "Cycle completion fraction from 0 to 1."},
    "queue": {"type": "integer", "minimum": 0},
    "temperature": {"type": ["number", "null"], "description": "Process temperature in degrees Celsius, or null when not applicable."},
    "pressure": {"type": ["number", "null"], "description": "Process pressure in bar, or null when not applicable."},
    "produced": {"type": "integer", "minimum": 0},
    "rejected": {"type": "integer", "minimum": 0}
  }
}
